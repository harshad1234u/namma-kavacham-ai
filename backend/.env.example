# Copy to backend/.env (or the repo-root .env) and fill in locally. Never commit real keys.
GEMINI_API_KEY=
# AI explanations run only when enabled AND a key is set; otherwise template text is used.
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=6
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_MESSAGE_BODY_CHARS=8000
MAX_UPLOAD_BYTES=8388608
