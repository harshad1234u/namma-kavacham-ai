# Copy to backend/.env (or the repo-root .env) and fill in locally. Never commit real keys.
# AI explanation provider: groq, gemini, or template. The chosen provider must also be enabled AND keyed;
# otherwise the template explanation is used. The risk result never depends on the provider.
LLM_PROVIDER=template
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=6
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_MESSAGE_BODY_CHARS=8000
MAX_UPLOAD_BYTES=8388608
